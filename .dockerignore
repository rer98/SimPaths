# Send only files used by the interactive SimPaths image.
*
!Dockerfile
!.dockerignore
!singlerun.jar
!webserver.properties
!README.md
!license.txt
!input/
!input/**

# Keep local-only or potentially restricted inputs out of Docker contexts.
input/.simpaths-web-profile.properties
input/.simpaths-profile-*.tmp
input/input.h2.db
input/input.trace.db
input/input.mv.db
input/input.mv.db.*
input/*.db
input/databases/
input/databases/**
input/population_IT.csv
input/population_UK.csv
input/tax_donor_population_UK.csv
input/**/*.dta
input/EUROMODoutput/*.txt
input/EUROMODoutput/augmented1/
input/EUROMODoutput/augmented1/**
input/EUROMODoutput/original/
input/EUROMODoutput/original/**
input/EUROMODoutput/base/
input/EUROMODoutput/base/**
input/EUROMODoutput/limit/
input/EUROMODoutput/limit/**
input/EUROMODoutput/test/
input/EUROMODoutput/test/**
input/InitialPopulations/*.csv
input/InitialPopulations/original/
input/InitialPopulations/original/**
input/InitialPopulations/base/
input/InitialPopulations/base/**
input/InitialPopulations/baseline/
input/InitialPopulations/baseline/**
input/InitialPopulations/limit/
input/InitialPopulations/limit/**
input/InitialPopulations/test/
input/InitialPopulations/test/**
