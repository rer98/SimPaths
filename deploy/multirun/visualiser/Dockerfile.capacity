# (C) Copyright 2026, by Ross Richardson
# Disposable, network-free-at-runtime Visualiser capacity benchmark tools.
# @author ross richardson
FROM node:22-bookworm-slim AS node
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends python3 libstdc++6 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
ENV PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8
USER 65532:65532
ENTRYPOINT ["python3", "/tools/visualiser_capacity_worker.py"]
