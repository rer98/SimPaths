# (C) Copyright 2026, by Ross Richardson
# Explicit scheduled online backup, encryption and pinned off-machine destination.
# @author ross richardson
# Install a reviewed private copy (0600); this example enables no timer or mail.
[source]
config = "/etc/simpaths-online/multirun.toml"
# client_container = "the-actual-loopback-postgres-container"

[backup]
directory = "/srv/simpaths-backups"
public_key = "/etc/simpaths-online/backup-recipient.asc"
recipient = "REPLACE_WITH_THE_FULL_PUBLIC_KEY_FINGERPRINT"
interval_hours = 24
retry_minutes = 30
# Default: retain completed local archives under keep_days/keep_latest below.
# After proving external retrieval/restore, "remote-only" removes their payloads
# only after verified remote archive AND receipt delivery; small records remain.
# It requires [remote]. Failed transfers keep their exact local archive for retry.
local_retention = "retain"
keep_days = 30
keep_latest = 3
minimum_free_gib = 1

# Optional. Remove this section until a separate protected backup host is chosen.
# The host key must be verified independently before installing known_hosts.
# Its SFTP service must support atomic hard-link publication, and the same
# pinned SSH endpoint must permit read-only cat for streamed verification.
# Hetzner Storage Box supplies these operations on SSH port 23.
[remote]
host = "backup-host.example.invalid"
user = "simpaths-backup"
port = 22
directory = "/backups/simpaths-online"
identity = "/etc/simpaths-online/backup-ssh-key"
known_hosts = "/etc/simpaths-online/backup-known-hosts"

[alerts]
enabled = false
# recipient = "operator@example.invalid"
