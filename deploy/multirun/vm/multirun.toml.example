# (C) Copyright 2026, by Ross Richardson
# Native VM settings: conservative staging allocation, not a measured VM size.
# @author ross richardson
[rpc]
socket = "/run/simpaths-executor/control.sock"
frontend_user = "simpaths-web"

[service]
origin = "https://multirun.example.org"
port = 5002
pool_id = "simpaths-online"
dedicated_storage = true

[paths]
frontend = "/opt/simpaths-online/JAS-mine-web"
private_root = "/srv/simpaths-online/private"
state = "/srv/simpaths-online/private/multirun"
dsn_file = "/etc/simpaths-online/postgres.dsn"
# Copy verified public training snapshots here; do not use temporary directories.
prepared = []

[workspaces]
# Administrator-owned broker on the private XFS filesystem; see WORKSPACE_QUOTAS.md.
# Required whenever service.dedicated_storage is true.
quota_socket = "/run/jasmine-workspace-quotas/broker.sock"
guard = "/usr/local/libexec/jasmine-workspace-guard"

[model]
# Replace with the reviewed, already installed model image's immutable ID.
image = "sha256:REPLACE_WITH_64_HEXADECIMAL_DIGITS"
# Must match the default selected by deploy.multirun.releases; old bundles/images
# remain retained. See deploy/multirun/RELEASES.md before changing versions.

[monitoring]
# Numeric hourly history only; no user names, URLs, input rows or model logs.
# Existing configurations without this section keep collection disabled.
enabled = true
sample_seconds = 15
retention_days = 30
max_rows = 20000

[pool]
# These are TOTAL allocations for model/result work. When SingleRun joins this
# pool, reserve interactive headroom here and configure its VM_SHARED_POOL_ID.
# hold_cpu_millis = 2000
# hold_memory_mib = 8192
# hold_storage_mib = 10240
# Increase total capacity above the holds to fit at least one batch workload.
# Allows one 50k model job and one default Visualiser processor together.
# Leave host/database/web-service reserves outside; include SingleRun only when
# it joins this common pool, increasing totals and choosing interactive holds.
cpu_millis = 3000
memory_mib = 6144
# Startup fallback. Enable the private live controller after reviewing filesystem
# headroom to follow later growth without restarting jobs; see STORAGE_BUDGET.md.
storage_mib = 13312
per_user_active = 1

[limits]
max_configurations = 100
max_repetitions = 12
max_unfinished_jobs = 110
pool_unfinished_jobs = 220
runtime_setup_minutes = 15
runtime_per_repetition_minutes = 60
runtime_budget_multiplier = 3
upload_allowance_gib = 4

[downloads]
threshold_mib = 512
cache_gib = 10
cache_hours = 24

[recovery]
# Applies only to newly reviewed simulation configurations; see VM.md.
# Capacity remains reserved before any live limit change. These are ceilings,
# not a promise of available RAM/disk. Leave host/database/web headroom outside.
enabled = false
pressure_percent = 85
memory_step_mib = 1024
max_memory_mib = 8192
heap_step_mib = 1024
max_heap_mib = 4096
storage_step_percent = 25
storage_multiplier = 2
check_seconds = 10

[notifications]
# Email sign-in is always required on the VM. These switches control job notices/expiry.
enabled = false
retention_cleanup = false
admin_email = ""
# Optional user warning after six continuous hours waiting for disk, followed
# by a confirmed-start update. Requires enabled=true; no repeated reminders.
storage_wait_emails = false
storage_wait_hours = 6

[visualiser]
# Optional pinned development build, for own inputs/public training only.
build = ""
preview = false
memory_mib = 1024
timeout_seconds = 600
# Independent chart and per-seed-summary periods, capped by source access.
cache_hours = 168
retain_completed_summaries = true
summary_hours = 168

# Private admin archive/mail settings. Enable before collection on the deployed
# host; enable mail only after notifications/admin_email and SMTP are configured.
# TOML seeds live controls on first startup; later changes use monitoring_exports.
[monitoring_exports]
enabled = false
mail_enabled = false
archive_seconds = 3600
delivery_seconds = 86400
journal_mib = 64
journal_rows = 100000
archive_mib = 512
archive_days = 30
part_mib = 2
