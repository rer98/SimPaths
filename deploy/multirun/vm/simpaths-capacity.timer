# (C) Copyright 2026, by Ross Richardson
# Five-minute host capacity checks, independent of application/job monitoring.
# @author ross richardson
[Unit]
Description=Periodically check SimPaths Online filesystem capacity

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=10s
RandomizedDelaySec=10s
Unit=simpaths-capacity.service

[Install]
WantedBy=timers.target
