# Opt-in delegated helper limits for bounded automatic chart preparation.
# Install as simpaths-executor.service.d/resources.conf after host acceptance.
# @author ross richardson
[Service]
Delegate=cpu memory pids
ProtectControlGroups=false
# Two 5 GiB parallel helper groups plus 2 GiB private orchestration/read helpers.
# Docker model containers remain in their own separately accounted cgroups.
MemoryMax=12G
MemorySwapMax=0
CPUQuota=500%
TasksMax=1024
