# Private executor and domain service; durable model attempts survive public frontend restarts.
# @author ross richardson
[Unit]
Description=SimPaths Online private executor
Requires=docker.service jasmine-workspace-quotas.service
After=network-online.target docker.service jasmine-workspace-quotas.service
Wants=network-online.target
RequiresMountsFor=/srv/simpaths-online/private
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=simpaths-online
Group=simpaths-rpc
SupplementaryGroups=docker simpaths-online
WorkingDirectory=/opt/simpaths-online/SimPaths
RuntimeDirectory=simpaths-executor
RuntimeDirectoryMode=0750
EnvironmentFile=/etc/simpaths-online/smtp.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/simpaths-online/venv/bin/python -m deploy.multirun.vm_executor preflight --config /etc/simpaths-online/multirun.toml
ExecStart=/opt/simpaths-online/venv/bin/python -m deploy.multirun.vm_executor serve --config /etc/simpaths-online/multirun.toml
Restart=always
RestartSec=10
# Drain private RPC streams; model containers have their own persisted deadlines.
TimeoutStopSec=infinity
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/simpaths-online/private/multirun
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryMax=3G
TasksMax=512
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
