# Public HTTP frontend with no Docker, private storage, database or SMTP authority.
# @author ross richardson
[Unit]
Description=SimPaths Online public MultiRun frontend
After=network-online.target simpaths-executor.service
Wants=network-online.target simpaths-executor.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=simpaths-web
Group=simpaths-web
SupplementaryGroups=simpaths-rpc
WorkingDirectory=/opt/simpaths-online/SimPaths
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/simpaths-online/venv/bin/python -m deploy.multirun.vm_frontend preflight --config /etc/simpaths-online/public.toml
ExecStart=/opt/simpaths-online/venv/bin/python -m deploy.multirun.vm_frontend serve --config /etc/simpaths-online/public.toml
Restart=always
RestartSec=10
TimeoutStopSec=infinity
KillSignal=SIGTERM
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
InaccessiblePaths=-/var/run/docker.sock -/run/docker.sock -/run/jasmine-workspace-quotas /srv/simpaths-online/private -/etc/simpaths-online/postgres.dsn -/etc/simpaths-online/smtp.env -/etc/simpaths-online/multirun.toml -/etc/simpaths-online/backup.toml -/srv/simpaths-backups
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=true
MemoryMax=1G
TasksMax=128
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
