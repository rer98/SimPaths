# systemd SMTP environment: install outside the checkout with mode 0600.
# @author ross richardson
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=REPLACE_WITH_SENDING_ADDRESS
SMTP_LOGIN_EMAIL=REPLACE_WITH_LOGIN
SMTP_PASSWORD=REPLACE_WITH_PASSWORD
